#!/bin/sh
# configure.win -- Windows configuration for the rvtk R package.
#
# Detection order:
#   0. VTK_DIR environment variable
#   1. Rtools45 pacman (query only -- never installs automatically)
#   2. Common Rtools45 / MSYS2 prefixes
#   3. Download pre-built libraries via tools/winlibs.R
#      (static by default; set VTK_LINK_TYPE=shared to download the DLL build)
#
# Static libraries (.a) are preferred over shared (.dll.a) when both are
# present at the same prefix.  If only shared libraries are found the script
# accepts them and copies the VTK DLLs into inst/vtk-dlls/ so that an
# .onLoad hook can prepend that directory to PATH at package load time.

set -e

echo "--- rvtk: configuring for Windows ---"

VTK_MIN_VERSION="9.1.0"
VTK_MIN_SUFFIX="$(echo "${VTK_MIN_VERSION}" | sed 's/\([0-9]*\)\.\([0-9]*\)\..*/\1.\2/')"

# ---------------------------------------------------------------------------
# Shared detection helpers.
# ---------------------------------------------------------------------------
. "$(dirname "$0")/tools/vtk-detect.sh"

# Extra state variables (in addition to those set by vtk-detect.sh).
vtk_link_type="static"
vtk_dll_dir=""
vtk_dll_dir_win=""

# ---------------------------------------------------------------------------
# Windows-specific build-flag helper
# ---------------------------------------------------------------------------

## vtk_build_flags LIB_PREFIX
## Tries static (.a, NOT .dll.a) first.  If none are found, falls back to
## shared import libs (.dll.a).  Sets vtk_found, vtk_link_type, vtk_dll_dir,
## vtk_cppflags, vtk_libs.
##
## MSYS2/Rtools45 paths (e.g. /ucrt64/lib) are converted to native Windows
## absolute paths via cygpath so that they remain valid when the linker is
## invoked outside the MSYS2 bash context (e.g. from R's make/cmd.exe).
vtk_build_flags() {
    _prefix="$1"
    _libdir="${_prefix}/lib"
    _bindir="${_prefix}/bin"

    ## Convert POSIX/MSYS2 paths to native Windows paths so they work
    ## both in MSYS2 bash (configure.win) and in R's make/linker context.
    if command -v cygpath > /dev/null 2>&1; then
        _win_libdir="$(cygpath -m "${_libdir}")"
        _win_bindir="$(cygpath -m "${_bindir}")"
        _win_inc="$(cygpath -m "${vtk_include_dir}")"
    else
        _win_libdir="${_libdir}"
        _win_bindir="${_bindir}"
        _win_inc="${vtk_include_dir}"
    fi

    ## ── Static (.a but NOT .dll.a) ────────────────────────────────────────
    _static_libs="$(find "${_libdir}" -maxdepth 1 -name "libvtk*.a" \
        ! -name "*.dll.a" 2>/dev/null \
        | sed 's|.*/lib\(.*\)\.a|-l\1|' | tr '\n' ' ')"

    if test -n "${_static_libs}"; then
        vtk_found="yes"
        vtk_link_type="static"
        vtk_cppflags="-I${_win_inc}"
        vtk_libs="-L${_win_libdir} -Wl,--start-group ${_static_libs}-lgdi32 -Wl,--end-group"
        echo "  -> linking VTK (static)"
        return 0
    fi

    ## ── Shared (.dll.a import libs) ───────────────────────────────────────
    _import_libs="$(find "${_libdir}" -maxdepth 1 -name "libvtk*.dll.a" 2>/dev/null \
        | sed 's|.*/lib\(.*\)\.dll\.a|-l\1|' | tr '\n' ' ')"

    if test -n "${_import_libs}"; then
        vtk_found="yes"
        vtk_link_type="shared"
        vtk_dll_dir="${_bindir}"
        vtk_dll_dir_win="${_win_bindir}"
        vtk_cppflags="-I${_win_inc}"
        vtk_libs="-L${_win_libdir} ${_import_libs}-lgdi32"
        echo "  -> linking VTK (shared via import libs; DLLs expected in ${_win_bindir})"
        return 0
    fi
}

# ---------------------------------------------------------------------------
# 0. User-supplied VTK_DIR
# ---------------------------------------------------------------------------
if test -n "${VTK_DIR}"; then
    echo "Checking VTK_DIR=${VTK_DIR} ..."
    if vtk_detect_from_prefix "${VTK_DIR}"; then
        vtk_build_flags "${VTK_DIR}"
        if test "${vtk_found}" = "yes"; then
            echo "  -> found VTK ${vtk_version_suffix} in VTK_DIR (${vtk_link_type})"
        else
            echo "  -> found VTK_DIR but no static or import libs; continuing."
        fi
    else
        echo "  -> VTK_DIR: no usable VTK libs or version < ${VTK_MIN_VERSION}; continuing."
    fi
fi

# ---------------------------------------------------------------------------
# 1. Rtools45 pacman (query only -- never installs automatically)
# ---------------------------------------------------------------------------
if test "${vtk_found}" = "no" && command -v pacman > /dev/null 2>&1; then
    for _pkg in \
        mingw-w64-ucrt-x86_64-vtk \
        mingw-w64-x86_64-vtk; do
        if pacman -Q "${_pkg}" > /dev/null 2>&1; then
            echo "Found pacman package ${_pkg}; locating prefix ..."
            _pacman_version="$(pacman -Q "${_pkg}" 2>/dev/null \
                | awk '{print $2}' | cut -d- -f1)"
            _prefix="$(pacman -Ql "${_pkg}" 2>/dev/null \
                | awk '/\/include\/vtk/{print $2; exit}' \
                | sed 's|/include/vtk.*||')"
            if test -n "${_prefix}" && vtk_detect_from_prefix "${_prefix}"; then
                vtk_build_flags "${_prefix}"
                if test "${vtk_found}" = "yes"; then
                    vtk_version="${_pacman_version}"
                    echo "  -> found VTK ${vtk_version} via pacman at ${_prefix} (${vtk_link_type})"
                fi
            else
                echo "  -> pacman package found but VTK detection failed; continuing."
            fi
            break
        fi
    done
fi

# ---------------------------------------------------------------------------
# 2. Common Rtools45 / MSYS2 prefixes
# ---------------------------------------------------------------------------
if test "${vtk_found}" = "no"; then
    for _base in \
        /x86_64-w64-mingw32.static.posix \
        /ucrt64 \
        /mingw64 \
        /usr/local \
        /usr; do
        if test -d "${_base}" && vtk_detect_from_prefix "${_base}"; then
            vtk_build_flags "${_base}"
            if test "${vtk_found}" = "yes"; then
                echo "  -> found VTK ${vtk_version_suffix} at ${_base} (${vtk_link_type})"
                break
            else
                echo "  -> found VTK at ${_base} but no usable libs; continuing."
            fi
        fi
    done
fi

# ---------------------------------------------------------------------------
# If a shared system VTK was found (steps 0-2), copy its DLLs into
# inst/vtk-dlls/ (a neutral staging area).  An .onLoad hook in R/vtk.R
# prepends this directory to PATH via Sys.setenv() at package load time,
# making the VTK DLLs visible to all subsequently loaded shared objects.
# Using inst/vtk-dlls/ avoids the R CMD check WARNING about inst/libs/ being
# reserved for package compiled-code artefacts.
# ---------------------------------------------------------------------------
if test "${vtk_found}" = "yes" && test "${vtk_link_type}" = "shared"; then
    if test -n "${vtk_dll_dir}" && test -d "${vtk_dll_dir}"; then
        mkdir -p inst/vtk-dlls
        _ndll=0
        for _dll in "${vtk_dll_dir}"/vtk*.dll "${vtk_dll_dir}"/libvtk*.dll; do
            test -f "${_dll}" || continue
            cp "${_dll}" inst/vtk-dlls/
            _ndll=$((_ndll + 1))
        done
        if test "${_ndll}" = "0"; then
            echo "WARNING: No VTK DLLs found in ${vtk_dll_dir}" >&2
            echo "         Run-time loading of downstream packages may fail." >&2
        else
            echo "  Copied ${_ndll} VTK DLL(s) to inst/vtk-dlls/"
        fi
    fi
fi

# ---------------------------------------------------------------------------
# 3. Fallback: download pre-built libraries
# ---------------------------------------------------------------------------
if test "${vtk_found}" = "no"; then
    echo "No system VTK found. Downloading pre-built libraries..."
    : "${R_HOME:=$(R RHOME)}"
    "${R_HOME}/bin/Rscript.exe" "tools/winlibs.R"
    echo "--- rvtk: Windows configuration complete (pre-built) ---"
    exit 0
fi

## Determine version string if not already set (pacman path sets it directly).
if test -z "${vtk_version}"; then
    if test -n "${vtk_version_suffix}"; then
        vtk_version="${vtk_version_suffix}.0"
    else
        vtk_version="unknown"
    fi
fi

# ---------------------------------------------------------------------------
# Write inst/vtk.conf
# ---------------------------------------------------------------------------
mkdir -p inst

## Convert the include dir to a Windows path if cygpath is available.
if command -v cygpath > /dev/null 2>&1; then
    vtk_include_dir_win="$(cygpath -m "${vtk_include_dir}")"
else
    vtk_include_dir_win="${vtk_include_dir}"
fi

cat > inst/vtk.conf << EOF
VTK_VERSION=${vtk_version}
VTK_CPPFLAGS=${vtk_cppflags}
VTK_LIBS=${vtk_libs}
VTK_INCLUDE_DIR=${vtk_include_dir_win}
VTK_LINK=${vtk_link_type}
VTK_DLL_DIR=${vtk_dll_dir_win}
EOF

echo "Written inst/vtk.conf (VTK ${vtk_version}, ${vtk_link_type})"
echo "--- rvtk: Windows configuration complete ---"
